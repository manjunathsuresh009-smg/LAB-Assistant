# Database (SQLite). Relative paths resolve from the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development

# Auth - use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-string"
JWT_EXPIRES_IN="12h"

# Comma separated list of allowed browser origins
FRONTEND_URL="http://localhost:5173,http://localhost:4000"

# Optional Gemini integration (backend only). Leave empty to use the deterministic engine.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
